# WXO External Agent Observability Configuration

# WXO Tenant identifier captured from the instance URL / settings
TENANT_ID="your_tenant_id_here"

# ID of the agent registered in the WXO UI
AGENT_ID="your_agent_id_here"

# Deployment environment label (e.g., draft, live)
ENVIRONMENT_NAME="draft"

# WXO OTLP/HTTP traces ingestion endpoint for the target instance
# Format: https://<api-domain>/instances/<instance-id>/v1/orchestrate/inject/traces
OTEL_EXPORT_URL="https://api.dl.watson-orchestrate.ibm.com/instances/<instance-id>/v1/orchestrate/inject/traces"

# API key used to obtain a bearer token for the ingestion endpoint
API_KEY="your_api_key_here"

# IAM/MCSP endpoint used to exchange API_KEY for a bearer token
# E.g., https://iam.cloud.ibm.com/identity/token or MCSP token endpoint
TOKEN_URL="https://iam.cloud.ibm.com/identity/token"
